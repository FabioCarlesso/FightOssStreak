# Template processado por envsubst no start do container (imagem oficial do nginx, script
# /docker-entrypoint.d/20-envsubst-on-templates.sh). Só ${PORT}, ${BACKEND_ORIGIN},
# ${NGINX_RESOLVER} e ${PUBLIC_HOST} são substituídos — ver NGINX_ENVSUBST_FILTER no
# Dockerfile. As demais variáveis ($uri, $host, $request_uri...) chegam intactas ao nginx.

# Zera o Origin quando ele aponta para o próprio app, e só nesse caso.
#
# O Chrome manda Origin em todo POST, inclusive same-origin. O Spring 6 trata qualquer
# requisição com Origin como CORS, e o WebCorsConfig só libera o dev server do Vite — o
# resultado era 403 "Invalid CORS request" ao aceitar o disclaimer pelo browser. Numa
# requisição que o próprio app originou, o header não descreve nada: o proxy é a mesma
# origem da página. Requisição de outra origem continua chegando com o Origin intacto, e
# o Spring segue recusando. Ver D25.
#
# A regex casa "esquema://X@@X": Origin cujo host é igual ao Host da requisição.
map "$http_origin@@$http_host" $proxy_origin {
    "~^https?://([^@]+)@@\1$"  "";
    default                    $http_origin;
}

# Preserva o esquema original da requisição.
#
# O TLS termina na borda da plataforma, então o nginx recebe http e $scheme vale "http".
# Sobrescrever X-Forwarded-Proto com ele faria o backend montar o redirect URI do OAuth em
# http://, e o provedor recusaria o login por redirect_uri divergente do cadastrado. Quando
# ninguém na frente mandou o header (Compose local, curl direto), $scheme é a resposta certa.
map $http_x_forwarded_proto $forwarded_proto {
    ""      $scheme;
    default $http_x_forwarded_proto;
}

# Sem versão no `Server:` nem nas páginas de erro (FOS-05). Vale para os dois `server` abaixo.
server_tokens off;

# O Cache-Control de cada caminho, num lugar só (#75).
#
# Ele morava em `add_header` dentro de `location /assets/` e `location = /index.html`, e
# `add_header` em `location` DESCARTA todos os do `server` — os cabeçalhos de segurança abaixo
# sumiriam justamente do HTML e dos bundles. Com o valor vindo daqui, o `server` tem um
# `add_header` só e nenhum `location` precisa repetir nada. Valor vazio não emite o cabeçalho: é o
# que deixa o `/api/` com o Cache-Control que o Spring escolheu.
#
# `$uri` é lido na resposta, depois do `try_files`: /hoje e / chegam aqui como /index.html.
map $uri $cache_control {
    ~^/assets/     "public, max-age=31536000, immutable";
    /index.html    "no-cache";
    default        "";
}

# Host que não é o do app não chega a lugar nenhum (FOS-02).
#
# O backend monta URL a partir do Host que o nginx repassa — o redirect URI do OAuth sai dele —,
# e com `server_name _` qualquer Host passava. O link dos e-mails já não depende disso (ele sai
# de FOS_PUBLIC_URL), mas é a mesma classe de defeito por outra porta: fechar aqui é o que
# impede a próxima rota que montar URL de herdar o problema.
#
# 444 é o código do nginx para "fecha a conexão sem responder". A exceção é o /healthz: o
# healthcheck da Railway chega com o Host dela (healthcheck.railway.app), e recusá-lo faria
# todo deploy falhar. Ele não toca o backend, então não há o que proteger ali.
server {
    listen ${PORT} default_server;
    server_name _;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 444;
    }
}

server {
    # A porta vem do ambiente: a Railway injeta a dela em runtime e ignora o EXPOSE.
    listen ${PORT};
    # O domínio público do app, sem esquema nem porta — o mesmo host de FOS_PUBLIC_URL. Mais de
    # um (domínio próprio além do da Railway) vai separado por espaço.
    server_name ${PUBLIC_HOST};

    root /usr/share/nginx/html;
    index index.html;

    # DNS do ambiente: 127.0.0.11 (embutido do Docker) local, [fd12::10] ipv6=on na rede
    # privada da Railway. `valid=1s` é curto de propósito — ver a nota no location /api/.
    resolver ${NGINX_RESOLVER} valid=1s;

    # Cabeçalhos de segurança (#75, FOS-05). Nenhum corrige defeito que exista hoje — o front não
    # tem sink de HTML e o React escapa —, e é por isso que entram agora: são a segunda barreira, e
    # ela se instala enquanto a primeira está inteira. Todos com `always`, para valerem também no
    # 404 e no 5xx. Nenhum `location` deste `server` pode ter `add_header` próprio, senão perde
    # todos estes — o Cache-Control vem do `map` no topo por esse motivo.
    #
    # CSP: tudo da própria origem, exceto o embed do YouTube (D7) — o player em `frame-src` e a
    # miniatura da tira de vídeos extras em `img-src`. `style-src` não precisa de 'unsafe-inline':
    # o Vite emite CSS em arquivo, e o `style={{...}}` do React escreve pelo CSSOM, que a CSP não
    # bloqueia. `frame-ancestors 'none'` impede que outro site enquadre o app, e o X-Frame-Options
    # diz o mesmo a navegador e WebView que não leem CSP. Ver D65.
    #
    # HSTS chega por HTTP no Compose local, e o navegador o ignora ali — o template segue um só.
    # Sem `preload`: compromete o domínio inteiro, e é decisão à parte.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://i.ytimg.com; frame-src https://www.youtube-nocookie.com; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Cache-Control $cache_control;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types application/javascript application/json image/svg+xml text/css text/plain;

    # Endpoint de healthcheck da plataforma. Não toca o backend de propósito: o que ele
    # responde é "o nginx está servindo", não "a API está de pé".
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        # proxy_pass com variável é o que força o nginx a re-resolver o nome pelo resolver
        # acima. Com URL literal ele resolve uma vez no start e cacheia para sempre — na
        # Railway o IP do backend muda a cada deploy, e o proxy passaria a servir 502.
        # Nesse modo o nginx não reescreve a URI, então ela vai explícita em $request_uri.
        set $upstream ${BACKEND_ORIGIN};

        # O Spring Security já manda estes três nas respostas da API, e o `server` acima também:
        # sem esconder os do backend, a resposta sairia com o cabeçalho repetido — e
        # X-Frame-Options repetido é tratado como inválido por parte dos navegadores. O nginx é a
        # fonte única, pelo mesmo motivo de os cabeçalhos estarem aqui e não no backend.
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Strict-Transport-Security;
        proxy_pass $upstream$request_uri;

        proxy_http_version 1.1;
        # $http_host, não $host: $host descarta a porta, e aí o Tomcat cai na porta do
        # próprio conector ao montar a URL da requisição.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # A cadeia de endereços de novo, sob um nome nosso — e é dela que sai a chave dos freios
        # do backend (#77). Duas razões para não reaproveitar o `X-Forwarded-For` acima:
        #
        # 1. O `forward-headers-strategy: framework` faz o Spring REMOVER todos os `X-Forwarded-*`
        #    da requisição antes de qualquer código da aplicação vê-los. O que ele deixa no lugar é
        #    o `getRemoteAddr()`, e ali ele põe o PRIMEIRO elemento da lista — que, como o
        #    `$proxy_add_x_forwarded_for` ACRESCENTA em vez de substituir, é exatamente o que o
        #    cliente escreveu. Um endereço novo por requisição zerava o freio de senha e o da
        #    demonstração.
        # 2. Aqui o nginx não sabe a resposta certa, e por isso não fixa como faz com o
        #    `X-Forwarded-Host` abaixo: atrás da borda da plataforma o `$remote_addr` é o endereço
        #    dela, igual para todo mundo. Quem sabe quantos saltos pular é o ambiente, e isso é
        #    configuração do backend (`FOS_PROXY_TRUSTED_HOPS`) — ver dev.fos.service.ClientIp.
        #
        # O que faz este header ser da infraestrutura e não de quem chama é o `proxy_set_header`:
        # o que o cliente mandar com este nome é descartado, e o que ele mandar no
        # `X-Forwarded-For` entra na CABEÇA da lista, enquanto a leitura conta a partir do fim.
        proxy_set_header X-Fos-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;

        # Os outros três headers que o backend usa para montar URL, fixados aqui para que o
        # cliente não os escolha. O `forward-headers-strategy: framework` honra todos, e sem
        # estas linhas eles passariam direto de quem chamou: `X-Forwarded-Host: evil.example`
        # bastava para o redirect URI do OAuth apontar para outro domínio. Diferente do
        # `X-Forwarded-Proto`, aqui o nginx sabe a resposta certa — é o mesmo `$http_host` que
        # ele já encaminha como `Host` —, então fixar é melhor que preservar.
        proxy_set_header X-Forwarded-Host $http_host;
        # Vazio remove o header. A porta, quando importa, já viaja no `$http_host` acima; deixar
        # o cliente mandá-la separada só serviria para divergir dele.
        proxy_set_header X-Forwarded-Port "";
        # O `Forwarded` da RFC 7239 tem precedência sobre todos os `X-Forwarded-*` no Spring, e
        # o nginx nunca o gera — se chegar, veio de fora.
        proxy_set_header Forwarded "";

        # Vazio quando a requisição veio do próprio app; intacto quando veio de fora.
        # Ver o `map` no topo do arquivo.
        proxy_set_header Origin $proxy_origin;
    }

    # Bundles do Vite têm hash no nome: podem ser cacheados para sempre (o valor vem do `map`).
    # O `location` continua existindo, vazio, para que bundle inexistente responda 404 em vez de
    # cair no fallback de SPA e devolver HTML com 200 no lugar de JavaScript.
    #
    # O index.html não tem hash e é quem aponta para os bundles novos — `no-cache`, também pelo
    # `map`, para o navegador não ficar preso na versão anterior depois de um deploy.
    location /assets/ {
    }

    # Fallback de SPA: /arvore e /no/M3.1 são rotas do react-router, não arquivos.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
