# Template processado por envsubst no start do container (imagem oficial do nginx, script
# /docker-entrypoint.d/20-envsubst-on-templates.sh). Só ${PORT}, ${BACKEND_ORIGIN} e
# ${NGINX_RESOLVER} são substituídos — ver NGINX_ENVSUBST_FILTER no Dockerfile. As demais
# variáveis ($uri, $host, $request_uri...) chegam intactas ao nginx.

# Zera o Origin quando ele aponta para o próprio app, e só nesse caso.
#
# O Chrome manda Origin em todo POST, inclusive same-origin. O Spring 6 trata qualquer
# requisição com Origin como CORS, e o WebCorsConfig só libera o dev server do Vite — o
# resultado era 403 "Invalid CORS request" ao aceitar o disclaimer pelo browser. Numa
# requisição que o próprio app originou, o header não descreve nada: o proxy é a mesma
# origem da página. Requisição de outra origem continua chegando com o Origin intacto, e
# o Spring segue recusando. Ver D25.
#
# A regex casa "esquema://X@@X": Origin cujo host é igual ao Host da requisição.
map "$http_origin@@$http_host" $proxy_origin {
    "~^https?://([^@]+)@@\1$"  "";
    default                    $http_origin;
}

# Preserva o esquema original da requisição.
#
# O TLS termina na borda da plataforma, então o nginx recebe http e $scheme vale "http".
# Sobrescrever X-Forwarded-Proto com ele faria o backend montar o redirect URI do OAuth em
# http://, e o provedor recusaria o login por redirect_uri divergente do cadastrado. Quando
# ninguém na frente mandou o header (Compose local, curl direto), $scheme é a resposta certa.
map $http_x_forwarded_proto $forwarded_proto {
    ""      $scheme;
    default $http_x_forwarded_proto;
}

server {
    # A porta vem do ambiente: a Railway injeta a dela em runtime e ignora o EXPOSE.
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # DNS do ambiente: 127.0.0.11 (embutido do Docker) local, [fd12::10] ipv6=on na rede
    # privada da Railway. `valid=1s` é curto de propósito — ver a nota no location /api/.
    resolver ${NGINX_RESOLVER} valid=1s;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types application/javascript application/json image/svg+xml text/css text/plain;

    # Endpoint de healthcheck da plataforma. Não toca o backend de propósito: o que ele
    # responde é "o nginx está servindo", não "a API está de pé".
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        # proxy_pass com variável é o que força o nginx a re-resolver o nome pelo resolver
        # acima. Com URL literal ele resolve uma vez no start e cacheia para sempre — na
        # Railway o IP do backend muda a cada deploy, e o proxy passaria a servir 502.
        # Nesse modo o nginx não reescreve a URI, então ela vai explícita em $request_uri.
        set $upstream ${BACKEND_ORIGIN};
        proxy_pass $upstream$request_uri;

        proxy_http_version 1.1;
        # $http_host, não $host: $host descarta a porta, e aí o Tomcat cai na porta do
        # próprio conector ao montar a URL da requisição.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # A cadeia de endereços de novo, sob um nome nosso — e é dela que sai a chave dos freios
        # do backend (#77). Duas razões para não reaproveitar o `X-Forwarded-For` acima:
        #
        # 1. O `forward-headers-strategy: framework` faz o Spring REMOVER todos os `X-Forwarded-*`
        #    da requisição antes de qualquer código da aplicação vê-los. O que ele deixa no lugar é
        #    o `getRemoteAddr()`, e ali ele põe o PRIMEIRO elemento da lista — que, como o
        #    `$proxy_add_x_forwarded_for` ACRESCENTA em vez de substituir, é exatamente o que o
        #    cliente escreveu. Um endereço novo por requisição zerava o freio de senha e o da
        #    demonstração.
        # 2. Aqui o nginx não sabe a resposta certa, e por isso não fixa como faz com o
        #    `X-Forwarded-Host` abaixo: atrás da borda da plataforma o `$remote_addr` é o endereço
        #    dela, igual para todo mundo. Quem sabe quantos saltos pular é o ambiente, e isso é
        #    configuração do backend (`FOS_PROXY_TRUSTED_HOPS`) — ver dev.fos.service.ClientIp.
        #
        # O que faz este header ser da infraestrutura e não de quem chama é o `proxy_set_header`:
        # o que o cliente mandar com este nome é descartado, e o que ele mandar no
        # `X-Forwarded-For` entra na CABEÇA da lista, enquanto a leitura conta a partir do fim.
        proxy_set_header X-Fos-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;

        # Os outros três headers que o backend usa para montar URL, fixados aqui para que o
        # cliente não os escolha. O `forward-headers-strategy: framework` honra todos, e sem
        # estas linhas eles passariam direto de quem chamou: `X-Forwarded-Host: evil.example`
        # bastava para o redirect URI do OAuth apontar para outro domínio. Diferente do
        # `X-Forwarded-Proto`, aqui o nginx sabe a resposta certa — é o mesmo `$http_host` que
        # ele já encaminha como `Host` —, então fixar é melhor que preservar.
        proxy_set_header X-Forwarded-Host $http_host;
        # Vazio remove o header. A porta, quando importa, já viaja no `$http_host` acima; deixar
        # o cliente mandá-la separada só serviria para divergir dele.
        proxy_set_header X-Forwarded-Port "";
        # O `Forwarded` da RFC 7239 tem precedência sobre todos os `X-Forwarded-*` no Spring, e
        # o nginx nunca o gera — se chegar, veio de fora.
        proxy_set_header Forwarded "";

        # Vazio quando a requisição veio do próprio app; intacto quando veio de fora.
        # Ver o `map` no topo do arquivo.
        proxy_set_header Origin $proxy_origin;
    }

    # Bundles do Vite têm hash no nome: podem ser cacheados para sempre.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # O index.html não tem hash e é quem aponta para os bundles novos. Cacheá-lo deixaria o
    # navegador preso na versão anterior depois de um deploy.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Fallback de SPA: /arvore e /no/M3.1 são rotas do react-router, não arquivos.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
