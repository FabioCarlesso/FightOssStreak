{
  "name": "fightossstreak",
  "private": true,
  "version": "0.1.0",
  "description": "Ferramenta pessoal de revisão e retenção do que é aprendido no tatame.",
  "license": "MIT",
  "workspaces": [
    "shared/domain",
    "shared/api-client",
    "shared/types",
    "web",
    "mobile"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @fos/web",
    "dev:mobile": "npm run start --workspace @fos/mobile",
    "dev:backend": "cd backend && ./mvnw spring-boot:run",
    "build": "npm run build --workspace @fos/domain && npm run build --workspace @fos/api-client && npm run build --workspace @fos/web",
    "test": "npm run test:domain && npm run test:api-client && npm run test:scripts && npm run test:web && npm run test:mobile",
    "test:domain": "npm run test --workspace @fos/domain",
    "test:api-client": "npm run test --workspace @fos/api-client",
    "test:scripts": "node --test --test-reporter=spec \"scripts/**/*.test.mjs\"",
    "test:web": "npm run test --workspace @fos/web",
    "test:mobile": "npm run test --workspace @fos/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "lint:fix": "eslint . --fix; prettier --write .",
    "gen:types": "node scripts/gen-types.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.4.4",
    "prettier": "^3.9.9",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=20"
  }
}
