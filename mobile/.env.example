# Copie para mobile/.env (fora do git) e ajuste. O Expo lê este arquivo na subida do Metro.
#
# Aponte para o BACKEND (:8080), não para o nginx (:8081): o nginx só atende PUBLIC_HOST e
# responde 444 a qualquer outro host (D62).
#
# Emulador Android: 10.0.2.2 é o localhost da máquina que roda o emulador.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
# iPhone físico ou Android físico: o IP da máquina na rede local, ex. http://192.168.0.10:8080

# O site, para o que continua só na web: criar conta e recuperar a senha (D68). Em produção é a
# URL pública do app; em dev, o Vite (`npm run dev:web`) ou deixe vazio.
EXPO_PUBLIC_WEB_URL=
