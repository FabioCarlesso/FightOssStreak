{
  "name": "@fos/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "App Android e iOS do FOS, em Expo (D67). Reaproveita shared/ pelos workspaces.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "start:dev-client": "expo start --dev-client",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fos/api-client": "*",
    "@fos/domain": "*",
    "@fos/types": "*",
    "expo": "~57.0.26",
    "expo-dev-client": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "~1.2.0",
    "typescript": "^5.6.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
