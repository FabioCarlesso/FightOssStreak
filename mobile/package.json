{
  "name": "@fos/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "App Android e iOS do FOS, em Expo (D67). Reaproveita shared/ pelos workspaces.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "start:dev-client": "expo start --dev-client",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fos/api-client": "*",
    "@fos/domain": "*",
    "@fos/tokens": "*",
    "@fos/types": "*",
    "expo": "~58.0.20",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.16",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.27",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-webview": "14.0.1",
    "react-native-youtube-iframe": "^2.4.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "test-renderer": "~1.3.1",
    "typescript": "^5.6.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
