{
  "openapi": "3.0.1",
  "info": {
    "title": "FightOssStreak API",
    "description": "API de currículo, progresso, streak e repetição espaçada.\n\nAVISO: o FightOssStreak é ferramenta de organização e revisão de estudos. Não ensina jiu-jitsu e não substitui instrução presencial com professor qualificado.",
    "license": {
      "name": "MIT"
    },
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Métricas",
      "description": "Critérios de sucesso do MVP medidos sobre o uso real"
    },
    {
      "name": "Demonstração",
      "description": "Sessão de demonstração descartável"
    },
    {
      "name": "Solicitações",
      "description": "Fila de acesso; restrita ao dono do app"
    },
    {
      "name": "Atividade",
      "description": "Streak, agenda de revisão e aceite do aviso"
    },
    {
      "name": "Currículo",
      "description": "Árvore de currículo, nós, quiz e registro de drill"
    },
    {
      "name": "Acesso por e-mail",
      "description": "Pedido de acesso e entrada por link"
    },
    {
      "name": "Conta",
      "description": "Login social, identidade da conta e exclusão"
    }
  ],
  "paths": {
    "/api/nodes/{code}/note": {
      "put": {
        "tags": [
          "Currículo"
        ],
        "summary": "Grava a anotação fixada do nó; nota em branco limpa a anotação",
        "operationId": "savePinnedNote",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PinnedNoteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PinnedNoteView"
                }
              }
            }
          }
        }
      }
    },
    "/api/nodes/{code}/quiz": {
      "post": {
        "tags": [
          "Currículo"
        ],
        "summary": "Submete o quiz conceitual e devolve nota e explicações",
        "operationId": "submitQuiz",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuizSubmission"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/QuizResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/nodes/{code}/drill": {
      "post": {
        "tags": [
          "Currículo"
        ],
        "summary": "Registra 'treinei isso hoje' — alimenta streak e reagenda o SRS",
        "operationId": "logDrill",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DrillRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DrillResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/disclaimer/accept": {
      "post": {
        "tags": [
          "Atividade"
        ],
        "summary": "Registra o aceite com data e versão do texto",
        "operationId": "acceptDisclaimer",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptDisclaimerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DisclaimerStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/demo/sessao": {
      "post": {
        "tags": [
          "Demonstração"
        ],
        "summary": "Abre uma demonstração",
        "description": "Cria uma conta descartável, copia o estado da conta-modelo com as datas rebaseadas e abre sessão. A conta é apagada por completo quando o prazo vence.",
        "operationId": "abrir",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DemoSessionView"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/email/solicitar": {
      "post": {
        "tags": [
          "Acesso por e-mail"
        ],
        "summary": "Registra um pedido de acesso",
        "description": "A conta nasce pendente e entra na fila do dono. Nenhum e-mail sai aqui: o dono recebe o resumo da fila na próxima janela do dia (10h às 22h), e quem pediu só recebe algo quando for aprovado.",
        "operationId": "solicitar",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/email/entrar": {
      "post": {
        "tags": [
          "Acesso por e-mail"
        ],
        "summary": "Pede o link de entrada",
        "description": "Responde igual para endereço inexistente, pendente, recusado e aprovado — do contrário viraria consulta de quem tem conta no app.",
        "operationId": "entrar",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/admin/solicitacoes/{id}/recusar": {
      "post": {
        "tags": [
          "Solicitações"
        ],
        "summary": "Recusa a conta; devolve a fila já sem ela",
        "description": "A conta recusada continua recusada nos logins seguintes e só pode se excluir.",
        "operationId": "deny",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AccessRequests"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/solicitacoes/{id}/aprovar": {
      "post": {
        "tags": [
          "Solicitações"
        ],
        "summary": "Libera a conta; devolve a fila já sem ela",
        "description": "Quem pediu por e-mail recebe aqui o primeiro link de entrada — é o único momento em que o app escreve para um endereço que ainda não entrou.",
        "operationId": "approve",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AccessRequests"
                }
              }
            }
          }
        }
      }
    },
    "/api/streak": {
      "get": {
        "tags": [
          "Atividade"
        ],
        "summary": "Streak atual, recorde e dias ativos nos últimos 30",
        "operationId": "streak",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/StreakView"
                }
              }
            }
          }
        }
      }
    },
    "/api/reviews/today": {
      "get": {
        "tags": [
          "Atividade"
        ],
        "summary": "O que drillar hoje, do mais atrasado para o menos",
        "operationId": "reviewsToday",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewAgenda"
                }
              }
            }
          }
        }
      }
    },
    "/api/nodes/{code}": {
      "get": {
        "tags": [
          "Currículo"
        ],
        "summary": "Detalhe de um nó: conceito, vídeo, quiz e agenda de revisão",
        "operationId": "node",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/NodeDetailView"
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics/mvp": {
      "get": {
        "tags": [
          "Métricas"
        ],
        "summary": "Os quatro critérios de sucesso do MVP, com valor e meta",
        "description": "As metas são as de docs/05-mvp-web-plano.md e valem para a janela de 30 dias.",
        "operationId": "mvp",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 30
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MvpMetrics"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "Conta"
        ],
        "summary": "Conta autenticada, com o estado do acesso",
        "description": "Responde também para conta pendente ou recusada: é o estado que diz para a web qual tela mostrar.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AccountView"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Conta"
        ],
        "summary": "Exclui a conta e todo o dado dela",
        "description": "Irreversível. Vale para conta aprovada, pendente ou recusada. A sessão é invalidada junto.",
        "operationId": "deleteMe",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/login/email/{token}": {
      "get": {
        "tags": [
          "Acesso por e-mail"
        ],
        "summary": "Consome o link e abre a sessão",
        "operationId": "consumir",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/disclaimer": {
      "get": {
        "tags": [
          "Atividade"
        ],
        "summary": "Estado do aceite do aviso de responsabilidade",
        "operationId": "disclaimer",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DisclaimerStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/curriculum/tree": {
      "get": {
        "tags": [
          "Currículo"
        ],
        "summary": "Árvore completa com estado de bloqueio resolvido para o usuário",
        "operationId": "tree",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TreeView"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/providers": {
      "get": {
        "tags": [
          "Conta"
        ],
        "summary": "Provedores de login habilitados",
        "description": "Só os que têm credencial configurada. Sem nenhum, a lista vem vazia e a tela de login não mostra botão — a aplicação sobe sem segredo nenhum.",
        "operationId": "providers",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthProviders"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/solicitacoes": {
      "get": {
        "tags": [
          "Solicitações"
        ],
        "summary": "Contas aguardando liberação, da mais antiga para a mais nova",
        "operationId": "pending",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AccessRequests"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PinnedNoteRequest": {
        "type": "object",
        "properties": {
          "note": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "PinnedNoteView": {
        "type": "object",
        "properties": {
          "nodeCode": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "Answer": {
        "required": [
          "optionId",
          "questionId"
        ],
        "type": "object",
        "properties": {
          "questionId": {
            "type": "integer",
            "format": "int64"
          },
          "optionId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "QuizSubmission": {
        "required": [
          "answers"
        ],
        "type": "object",
        "properties": {
          "answers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Answer"
            }
          }
        }
      },
      "QuestionFeedback": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "integer",
            "format": "int64"
          },
          "prompt": {
            "type": "string"
          },
          "chosenOptionId": {
            "type": "integer",
            "format": "int64"
          },
          "correctOptionId": {
            "type": "integer",
            "format": "int64"
          },
          "correct": {
            "type": "boolean"
          },
          "explanation": {
            "type": "string"
          }
        }
      },
      "QuizResult": {
        "type": "object",
        "properties": {
          "score": {
            "type": "integer",
            "format": "int32"
          },
          "correctCount": {
            "type": "integer",
            "format": "int32"
          },
          "totalQuestions": {
            "type": "integer",
            "format": "int32"
          },
          "passed": {
            "type": "boolean"
          },
          "passingScore": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string",
            "enum": [
              "LOCKED",
              "AVAILABLE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "feedback": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionFeedback"
            }
          }
        }
      },
      "DrillRequest": {
        "required": [
          "recall"
        ],
        "type": "object",
        "properties": {
          "recall": {
            "type": "string",
            "enum": [
              "FORGOT",
              "HARD",
              "OK",
              "EASY"
            ]
          },
          "note": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string"
          },
          "drilledOn": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "DrillResult": {
        "type": "object",
        "properties": {
          "nodeCode": {
            "type": "string"
          },
          "drilledOn": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "LOCKED",
              "AVAILABLE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "nextReviewOn": {
            "type": "string",
            "format": "date"
          },
          "intervalDays": {
            "type": "integer",
            "format": "int32"
          },
          "streak": {
            "$ref": "#/components/schemas/StreakView"
          }
        }
      },
      "StreakView": {
        "type": "object",
        "properties": {
          "currentStreak": {
            "type": "integer",
            "format": "int32"
          },
          "longestStreak": {
            "type": "integer",
            "format": "int32"
          },
          "drilledToday": {
            "type": "boolean"
          },
          "activeDaysLast30": {
            "type": "integer",
            "format": "int32"
          },
          "targetDaysLast30": {
            "type": "integer",
            "format": "int32"
          },
          "today": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "AcceptDisclaimerRequest": {
        "required": [
          "version"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          }
        }
      },
      "DisclaimerStatus": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "acceptedVersion": {
            "type": "string"
          },
          "currentVersion": {
            "type": "string"
          },
          "shortNotice": {
            "type": "string"
          }
        }
      },
      "DemoSessionView": {
        "type": "object",
        "properties": {
          "destino": {
            "type": "string"
          },
          "expiraEm": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EmailRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "AccessRequestView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "requestedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AccessRequests": {
        "type": "object",
        "properties": {
          "requests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccessRequestView"
            }
          }
        }
      },
      "DueItemView": {
        "type": "object",
        "properties": {
          "nodeCode": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "belt": {
            "type": "string",
            "enum": [
              "BRANCA",
              "AZUL",
              "ROXA"
            ]
          },
          "moduleCode": {
            "type": "string"
          },
          "nextReviewOn": {
            "type": "string",
            "format": "date"
          },
          "daysOverdue": {
            "type": "integer",
            "format": "int64"
          },
          "lastQuizScore": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ReviewAgenda": {
        "type": "object",
        "properties": {
          "today": {
            "type": "string",
            "format": "date"
          },
          "dueCount": {
            "type": "integer",
            "format": "int32"
          },
          "due": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DueItemView"
            }
          }
        }
      },
      "DrillEntryView": {
        "type": "object",
        "properties": {
          "drilledOn": {
            "type": "string",
            "format": "date"
          },
          "recall": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "ExtraVideoView": {
        "type": "object",
        "properties": {
          "youtubeId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "startSeconds": {
            "type": "integer",
            "format": "int32"
          },
          "orientation": {
            "type": "string",
            "enum": [
              "HORIZONTAL",
              "VERTICAL"
            ]
          },
          "note": {
            "type": "string"
          },
          "embedUrl": {
            "type": "string"
          },
          "watchUrl": {
            "type": "string"
          },
          "thumbnailUrl": {
            "type": "string"
          }
        }
      },
      "NodeDetailView": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "belt": {
            "type": "string",
            "enum": [
              "BRANCA",
              "AZUL",
              "ROXA"
            ]
          },
          "concept": {
            "type": "string"
          },
          "moduleCode": {
            "type": "string"
          },
          "moduleTitle": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "LOCKED",
              "AVAILABLE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "unlockRule": {
            "type": "string",
            "enum": [
              "ALL",
              "ANY"
            ]
          },
          "prereqs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PrereqView"
            }
          },
          "video": {
            "$ref": "#/components/schemas/VideoView"
          },
          "extraVideos": {
