{
  "openapi": "3.0.1",
  "info": {
    "title": "FightOssStreak API",
    "description": "API de currículo, progresso, streak e repetição espaçada.\n\nAVISO: o FightOssStreak é ferramenta de organização e revisão de estudos. Não ensina jiu-jitsu e não substitui instrução presencial com professor qualificado.",
    "license": {
      "name": "MIT"
    },
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Métricas",
      "description": "Critérios de sucesso do MVP medidos sobre o uso real"
    },
    {
      "name": "Demonstração",
      "description": "Sessão de demonstração descartável"
    },
    {
      "name": "Feedback",
      "description": "Bug, conteúdo errado, troca de vídeo, sugestão"
    },
    {
      "name": "Cadastro e senha",
      "description": "Conta com e-mail e senha, confirmada por link"
    },
    {
      "name": "Atividade",
      "description": "Streak, agenda de revisão e aceite do aviso"
    },
    {
      "name": "Currículo",
      "description": "Árvore de currículo, nós, quiz e registro de drill"
    },
    {
      "name": "Conta",
      "description": "Login social, identidade da conta e exclusão"
    },
    {
      "name": "Administração",
      "description": "Fila de feedback; restrita à conta de administração"
    }
  ],
  "paths": {
    "/api/nodes/{code}/note": {
      "put": {
        "tags": [
          "Currículo"
        ],
        "summary": "Grava a anotação fixada do nó; nota em branco limpa a anotação",
        "operationId": "savePinnedNote",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PinnedNoteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PinnedNoteView"
                }
              }
            }
          }
        }
      }
    },
    "/api/nodes/{code}/quiz": {
      "post": {
        "tags": [
          "Currículo"
        ],
        "summary": "Submete o quiz conceitual e devolve nota e explicações",
        "operationId": "submitQuiz",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuizSubmission"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/QuizResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/nodes/{code}/drill": {
      "post": {
        "tags": [
          "Currículo"
        ],
        "summary": "Registra 'treinei isso hoje' — alimenta streak e reagenda o SRS",
        "operationId": "logDrill",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DrillRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DrillResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/feedback": {
      "post": {
        "tags": [
          "Feedback"
        ],
        "summary": "Envia um feedback; opcionalmente amarrado a um nó do currículo",
        "operationId": "submit",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackView"
                }
              }
            }
          }
        }
      }
    },
    "/api/disclaimer/accept": {
      "post": {
        "tags": [
          "Atividade"
        ],
        "summary": "Registra o aceite com data e versão do texto",
        "operationId": "acceptDisclaimer",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptDisclaimerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DisclaimerStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/demo/sessao": {
      "post": {
        "tags": [
          "Demonstração"
        ],
        "summary": "Abre uma demonstração",
        "description": "Cria uma conta descartável, copia o estado da conta-modelo com as datas rebaseadas e abre sessão. A conta é apagada por completo quando o prazo vence.",
        "operationId": "abrir",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DemoSessionView"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/verificar/{token}": {
      "get": {
        "tags": [
          "Cadastro e senha"
        ],
        "summary": "O link de confirmação ainda vale?",
        "description": "Consulta que não gasta o link, como a da redefinição: quem abre a URL do e-mail nem sempre é quem a recebeu — varredor de link corporativo e antivírus de caixa de entrada seguem tudo que chega, e um GET que confirmasse queimaria o link antes do clique.",
        "operationId": "conferirConfirmacao",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LinkView"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Cadastro e senha"
        ],
        "summary": "Confirma o e-mail e abre a sessão",
        "description": "É aqui que a conta passa a existir de verdade. POST, e não GET, porque confirmar é ato explícito de quem leu o e-mail — nenhuma máquina que só siga links chega a esta rota.",
        "operationId": "confirmar",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/verificacao/reenviar": {
      "post": {
        "tags": [
          "Cadastro e senha"
        ],
        "summary": "Manda outro link de confirmação",
        "description": "O link anterior deixa de valer. Responde igual para cadastro pendente, confirmado e inexistente.",
        "operationId": "reenviar",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/senha/redefinir/{token}": {
      "get": {
        "tags": [
          "Cadastro e senha"
        ],
        "summary": "O link de redefinição ainda vale?",
        "description": "Consulta que não gasta o link: consumir na abertura da tela o queimaria em qualquer pré-carregamento do navegador ou do cliente de e-mail.",
        "operationId": "conferir",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LinkView"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Cadastro e senha"
        ],
        "summary": "Troca a senha",
        "description": "Queima os links pendentes da conta e encerra as sessões abertas nela. Não abre sessão: a próxima tela é o login, com a senha nova.",
        "operationId": "redefinir",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SenhaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/senha/esquecida": {
      "post": {
        "tags": [
          "Cadastro e senha"
        ],
        "summary": "Manda o link de redefinição",
        "description": "Responde igual para endereço com conta e sem conta.",
        "operationId": "esquecida",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Cadastro e senha"
        ],
        "summary": "Entra com e-mail e senha",
        "description": "401 sem dizer se o e-mail existe; 403 quando a senha confere mas o endereço ainda não foi confirmado; 429 no freio de tentativas.",
        "operationId": "entrar",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/cadastro": {
      "post": {
        "tags": [
          "Cadastro e senha"
        ],
        "summary": "Cria a conta e manda o link de confirmação",
        "description": "Não abre sessão: a conta nasce não verificada e só existe de verdade quando o link for aberto. Responde igual para e-mail novo e já cadastrado — do contrário viraria consulta de quem tem conta no app.",
        "operationId": "cadastrar",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CadastroRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/admin/feedback/{id}/status": {
      "post": {
        "tags": [
          "Administração"
        ],
        "summary": "Muda o status de um feedback (em análise, resolvido, recusado)",
        "operationId": "decideFeedback",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackStatusRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackView"
                }
              }
            }
          }
        }
      }
    },
    "/api/streak": {
      "get": {
        "tags": [
          "Atividade"
        ],
        "summary": "Streak atual, recorde e dias ativos nos últimos 30",
        "operationId": "streak",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/StreakView"
                }
              }
            }
          }
        }
      }
    },
    "/api/reviews/today": {
      "get": {
        "tags": [
          "Atividade"
        ],
        "summary": "O que drillar hoje, do mais atrasado para o menos",
        "operationId": "reviewsToday",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewAgenda"
                }
              }
            }
          }
        }
      }
    },
    "/api/nodes/{code}": {
      "get": {
        "tags": [
          "Currículo"
        ],
        "summary": "Detalhe de um nó: conceito, vídeo, quiz e agenda de revisão",
        "operationId": "node",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/NodeDetailView"
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics/mvp": {
      "get": {
        "tags": [
          "Métricas"
        ],
        "summary": "Os quatro critérios de sucesso do MVP, com valor e meta",
        "description": "As metas são as de docs/05-mvp-web-plano.md e valem para a janela de 30 dias.",
        "operationId": "mvp",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 30
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MvpMetrics"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "Conta"
        ],
        "summary": "Conta autenticada, com o estado do acesso",
        "description": "Responde também para conta pendente ou recusada: é o estado que diz para a web qual tela mostrar.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AccountView"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Conta"
        ],
        "summary": "Exclui a conta e todo o dado dela",
        "description": "Irreversível: apaga a conta, a identidade, o hash da senha, os links pendentes e todo o progresso. A sessão é invalidada junto.",
        "operationId": "deleteMe",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/disclaimer": {
      "get": {
        "tags": [
          "Atividade"
        ],
        "summary": "Estado do aceite do aviso de responsabilidade",
        "operationId": "disclaimer",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DisclaimerStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/curriculum/tree": {
      "get": {
        "tags": [
          "Currículo"
        ],
        "summary": "Árvore completa com estado de bloqueio resolvido para o usuário",
        "operationId": "tree",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TreeView"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/providers": {
      "get": {
        "tags": [
          "Conta"
        ],
        "summary": "Provedores de login habilitados",
        "description": "Só os que têm credencial configurada. Sem nenhum, a lista vem vazia e a tela de login não mostra botão — a aplicação sobe sem segredo nenhum.",
        "operationId": "providers",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthProviders"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/feedback": {
      "get": {
        "tags": [
          "Administração"
        ],
        "summary": "Fila de feedback, da mais antiga para a mais nova",
        "operationId": "feedback",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackList"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PinnedNoteRequest": {
        "type": "object",
        "properties": {
          "note": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "PinnedNoteView": {
        "type": "object",
        "properties": {
          "nodeCode": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "Answer": {
        "required": [
          "optionId",
          "questionId"
        ],
        "type": "object",
        "properties": {
          "questionId": {
            "type": "integer",
            "format": "int64"
          },
          "optionId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "QuizSubmission": {
        "required": [
          "answers"
        ],
        "type": "object",
        "properties": {
          "answers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Answer"
            }
          }
        }
      },
      "QuestionFeedback": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "integer",
            "format": "int64"
          },
          "prompt": {
            "type": "string"
          },
          "chosenOptionId": {
            "type": "integer",
            "format": "int64"
          },
          "correctOptionId": {
            "type": "integer",
            "format": "int64"
          },
          "correct": {
            "type": "boolean"
          },
          "explanation": {
            "type": "string"
          }
        }
      },
      "QuizResult": {
        "type": "object",
        "properties": {
          "score": {
            "type": "integer",
            "format": "int32"
          },
          "correctCount": {
            "type": "integer",
            "format": "int32"
          },
          "totalQuestions": {
            "type": "integer",
            "format": "int32"
          },
          "passed": {
            "type": "boolean"
          },
          "passingScore": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string",
            "enum": [
              "LOCKED",
              "AVAILABLE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "feedback": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionFeedback"
            }
          }
        }
      },
      "DrillRequest": {
        "required": [
          "recall"
        ],
        "type": "object",
        "properties": {
          "recall": {
            "type": "string",
            "enum": [
              "FORGOT",
              "HARD",
              "OK",
              "EASY"
            ]
          },
          "note": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string"
          },
          "drilledOn": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "DrillResult": {
        "type": "object",
        "properties": {
          "nodeCode": {
            "type": "string"
          },
          "drilledOn": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "LOCKED",
              "AVAILABLE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "nextReviewOn": {
            "type": "string",
            "format": "date"
          },
          "intervalDays": {
            "type": "integer",
            "format": "int32"
          },
          "streak": {
            "$ref": "#/components/schemas/StreakView"
          }
        }
      },
      "StreakView": {
        "type": "object",
        "properties": {
          "currentStreak": {
            "type": "integer",
            "format": "int32"
          },
          "longestStreak": {
            "type": "integer",
            "format": "int32"
          },
          "drilledToday": {
            "type": "boolean"
          },
          "activeDaysLast30": {
            "type": "integer",
            "format": "int32"
          },
          "targetDaysLast30": {
            "type": "integer",
            "format": "int32"
          },
          "today": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "FeedbackRequest": {
        "required": [
          "category",
          "message"
        ],
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "BUG",
              "CONTEUDO_ERRADO",
              "TROCA_DE_VIDEO",
              "SUGESTAO_FUNCIONALIDADE",
              "OUTRO"
            ]
          },
          "nodeCode": {
            "type": "string"
          },
          "message": {
            "maxLength": 2000,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "FeedbackView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "category": {
            "type": "string",
            "enum": [
              "BUG",
              "CONTEUDO_ERRADO",
              "TROCA_DE_VIDEO",
              "SUGESTAO_FUNCIONALIDADE",
